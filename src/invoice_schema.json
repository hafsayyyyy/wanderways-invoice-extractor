{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WanderWays Travel Invoice Extraction",
  "type": "object",
  "properties": {
    "invoice_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "total_amount": {"type": ["number", "null"]},
    "vendor_name": {"type": ["string", "null"]},
    "travel_dates": {"type": "array", "items": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}},
    "booking_reference": {"type": ["string", "null"]}
  },
  "required": ["invoice_date", "total_amount", "vendor_name", "travel_dates", "booking_reference"],
  "additionalProperties": false
}
